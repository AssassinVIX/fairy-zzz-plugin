{
  "name": "dsh-fairy-zzz",
  "version": "1.0.2",
  "description": "Zenless Zone Zero Fairy skin for the DSH Web UI: H.D.D boot animation, animated eye core, time-of-day greeting line, idle blink and glitch, thinking eyelid, plus optional local GPT-SoVITS voice.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AssassinVIX/fairy-zzz-plugin.git"
  },
  "homepage": "https://github.com/AssassinVIX/fairy-zzz-plugin#readme",
  "bugs": {
    "url": "https://github.com/AssassinVIX/fairy-zzz-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "theme",
    "skin",
    "zenless-zone-zero",
    "fairy",
    "tts"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./assets/icon-180.png"
  },
  "icon": "assets/icon-180.png",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets",
    "presets",
    "screenshots",
    "screenshots.json",
    "icon.svg",
    "install-windows.ps1",
    "README.md",
    "LICENSE",
    "NOTICE-fairy-dsh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
